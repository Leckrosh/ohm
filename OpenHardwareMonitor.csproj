<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenHardwareMonitor</RootNamespace>
    <AssemblyName>OpenHardwareMonitor</AssemblyName>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>Resources\app.manifest</ApplicationManifest>
    <StartupObject>OpenHardwareMonitor.Program</StartupObject>
    <!-- This project shares its directory with OpenHardwareMonitorLib.csproj, so
         default item globbing must stay off and files are listed explicitly. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Single-file executable: publish with
           dotnet publish OpenHardwareMonitor.csproj -c Release
         The self-contained single .exe is written to
           Bin\OpenHardwareMonitor\Release\net8.0-windows\win-x64\publish\ -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- IncludeAllContentForSelfExtract also bundles the WindowsDesktop native
         libraries (*_cor3.dll), which the SDK otherwise leaves next to the exe;
         they are extracted to a temp folder on first run. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtraction>true</IncludeNativeLibrariesForSelfExtraction>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
